{
  "name": "@codecon/api",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@codecon/auth": "workspace:*",
    "@codecon/db": "workspace:*",
    "@codecon/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codecon/config": "workspace:*",
    "hono": "catalog:",
    "tsdown": "^0.22.0",
    "typescript": "catalog:"
  }
}
