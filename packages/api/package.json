{
  "name": "@codecon/api",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "bunx vitest@3.2.4 run"
  },
  "dependencies": {
    "@codecon/auth": "workspace:*",
    "@codecon/db": "workspace:*",
    "@codecon/env": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codecon/config": "workspace:*",
    "tsdown": "^0.22.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
